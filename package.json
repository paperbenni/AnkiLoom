{
  "name": "ankiloom-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:generate": "uv run --locked python scripts/generate_docs.py",
    "docs:dev": "npm run docs:generate && vitepress dev docs",
    "docs:build": "npm run docs:generate && vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "vitepress": "2.0.0-alpha.21"
  },
  "engines": {
    "node": ">=22.12"
  }
}
